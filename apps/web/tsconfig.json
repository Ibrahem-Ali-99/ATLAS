{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-e2e-phase2d/types/**/*.ts",
    ".next-e2e-phase2d/dev/types/**/*.ts",
    ".next-product-completion/types/**/*.ts",
    ".next-product-completion/dev/types/**/*.ts",
    ".next-dashboard-acceptance/types/**/*.ts",
    ".next-dashboard-acceptance/dev/types/**/*.ts",
    ".next-workflows-integrations/types/**/*.ts",
    ".next-workflows-integrations/dev/types/**/*.ts",
    ".next-populated-workspace/types/**/*.ts",
    ".next-populated-workspace/dev/types/**/*.ts",
    ".next-dashboard-acceptance-final/types/**/*.ts",
    ".next-dashboard-acceptance-final/dev/types/**/*.ts",
    ".next-figma-acceptance/types/**/*.ts",
    ".next-figma-acceptance/dev/types/**/*.ts",
    ".next-figma-capture/types/**/*.ts",
    ".next-figma-capture/dev/types/**/*.ts",
    ".next-local-capture/types/**/*.ts",
    ".next-local-capture/dev/types/**/*.ts",
    ".next-fidelity-capture/types/**/*.ts",
    ".next-fidelity-capture/dev/types/**/*.ts",
    ".next-dark-acceptance/types/**/*.ts",
    ".next-dark-acceptance/dev/types/**/*.ts",
    ".next-atlas-dark/types/**/*.ts",
    ".next-atlas-dark/dev/types/**/*.ts",
    ".next-structural-acceptance/types/**/*.ts",
    ".next-structural-acceptance/dev/types/**/*.ts",
    ".next-figma-auth-rerun/types/**/*.ts",
    ".next-figma-auth-rerun/dev/types/**/*.ts",
    ".next-overview-capture-final/types/**/*.ts",
    ".next-overview-capture-final/dev/types/**/*.ts",
    ".next-crm-acceptance/types/**/*.ts",
    ".next-crm-acceptance/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-e2e",
    "src/lib/api-base.test.ts"
  ]
}
