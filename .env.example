# Copy to .env before starting the stack. .env is gitignored.
# Replace every placeholder before using a shared or deployed environment.
# These values are local development placeholders, not production secrets.

ATLAS_ENVIRONMENT=development
# Set true only for a shared demo. It refuses paid model keys, live email, n8n, and the seed.
ATLAS_PUBLIC_DEMO=false
ATLAS_SECRET_KEY=replace-with-a-long-random-string
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
ATLAS_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ATLAS_COOKIE_SECURE=false
ATLAS_LOG_LEVEL=INFO
ATLAS_SESSION_TTL_HOURS=12

# openai uses the keys below. double is a deterministic stand-in for tests and local browser runs.
# Production refuses double. Leave the keys empty until a provider is configured.
ATLAS_LLM_PROVIDER=openai
ATLAS_EMBEDDING_PROVIDER=openai
# OpenAI-compatible chat and embeddings. Leave the keys empty until a provider is configured.
# Empty keys make those calls fail with a clear error. The API does not invent a successful answer.
ATLAS_LLM_BASE_URL=https://api.openai.com/v1
ATLAS_LLM_API_KEY=
ATLAS_LLM_MODEL=gpt-4o-mini
ATLAS_EMBEDDING_BASE_URL=https://api.openai.com/v1
ATLAS_EMBEDDING_API_KEY=
ATLAS_EMBEDDING_MODEL=text-embedding-3-small
ATLAS_EMBEDDING_DIMENSIONS=1536
# pgvector cosine distance is 1 - cosine similarity. Larger values are less similar.
# Vector neighbors beyond this distance are dropped. A full-text match can still cite
# that passage, so a shared keyword may be returned even when the vectors are far apart.
# Paraphrases with no shared words are returned only when their distance is at or below this value.
ATLAS_MAX_COSINE_DISTANCE=0.55
ATLAS_MAX_UPLOAD_BYTES=10485760
# Optional. Defaults to var/atlas-storage under the repository root.
ATLAS_STORAGE_DIR=
# How long a proposed agent action stays approvable. A change to the stored payload invalidates it.
ATLAS_APPROVAL_TTL_HOURS=24

# Automation. Sandbox email delivers only to a local SMTP host such as Mailpit.
# Live email also requires ATLAS_EMAIL_LIVE_ENABLED=true and an admin approval.
# n8n in Docker calls this URL. host.docker.internal reaches an API on the host.
# The Compose API service overrides it with http://api:8000.
ATLAS_PUBLIC_API_URL=http://host.docker.internal:8000
ATLAS_N8N_LEAD_WEBHOOK_URL=http://127.0.0.1:5678/webhook/atlas-lead
ATLAS_EMAIL_MODE=sandbox
ATLAS_EMAIL_LIVE_ENABLED=false
ATLAS_SMTP_HOST=127.0.0.1
ATLAS_SMTP_PORT=1025
ATLAS_SMTP_FROM=atlas@localhost
ATLAS_CALENDAR_MODE=simulation

# Optional Langfuse export. Leave both keys empty to keep traces local only.
# Token prices are optional. Empty prices make cost unavailable instead of inventing a number.
ATLAS_LANGFUSE_PUBLIC_KEY=
ATLAS_LANGFUSE_SECRET_KEY=
ATLAS_LANGFUSE_HOST=
ATLAS_LLM_INPUT_USD_PER_MILLION=
ATLAS_LLM_OUTPUT_USD_PER_MILLION=
# Optional directory for trained model artifacts. Defaults to var/atlas-models.
ATLAS_MODEL_DIR=

# n8n and Mailpit. Copy the webhook key id and secret from ATLAS into these after creating the key.
# Leave the secret empty until then. Do not commit a real secret.
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
ATLAS_HOOK_KEY_ID=
ATLAS_HOOK_SECRET=
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
# Host port for Postgres. Use another port if 5432 is already taken on the machine.
POSTGRES_PORT=5432
API_PORT=8000

# Local development accounts only. The seed resets these passwords and refuses
# ATLAS_ENVIRONMENT=production and ATLAS_PUBLIC_DEMO=true. Change them before sharing.
# ATLAS_PUBLIC_DEMO=true also refuses live email, an n8n URL, and paid model keys.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
SEED_ADMIN_NAME=Avery Admin
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=change-me-staff
SEED_STAFF_NAME=Sam Staff
SEED_OUTSIDER_EMAIL=outsider@example.org
SEED_OUTSIDER_PASSWORD=change-me-outsider
SEED_OUTSIDER_NAME=Olivia Outsider
