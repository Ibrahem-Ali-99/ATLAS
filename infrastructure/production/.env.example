# Copy to infrastructure/production/.env before the first boot.
# .env is gitignored. Replace every placeholder. Preflight rejects this file unchanged.
# Do not point these values at the development database or infrastructure/staging/.env.

PRODUCTION_ENVIRONMENT=production
PRODUCTION_PUBLIC_DEMO=false
PRODUCTION_SECRET_KEY=replace-with-a-long-random-string
# Independent of the session secret. Keep previous entries while older seals exist.
PRODUCTION_CREDENTIAL_ENCRYPTION_KEYS=prod-01=replace-with-an-independent-random-string
PRODUCTION_POSTGRES_USER=atlas
PRODUCTION_POSTGRES_PASSWORD=replace-with-a-long-random-string
PRODUCTION_POSTGRES_DB=atlas
PRODUCTION_N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# Local proof uses atlas.localhost and high ports.
# A public name must use ports 80 and 443 so Caddy can finish the HTTP-01 challenge.
PRODUCTION_HOST=atlas.localhost
PRODUCTION_HTTP_PORT=19080
PRODUCTION_HTTPS_PORT=19443
PRODUCTION_CORS_ORIGINS=https://atlas.localhost:19443
PRODUCTION_CAMPAIGN_PUBLIC_URL=https://atlas.localhost:19443
PRODUCTION_LOG_LEVEL=INFO
PRODUCTION_COOKIE_SECURE=true

# Create the first administrator with python -m app.scripts.bootstrap.
# Pass the JSON on stdin. Do not store that password in this file or the image.

PRODUCTION_LLM_PROVIDER=groq
PRODUCTION_LLM_BASE_URL=https://api.groq.com/openai/v1
PRODUCTION_LLM_API_KEY=replace-with-a-long-random-string
PRODUCTION_LLM_MODEL=replace-with-the-chat-model
PRODUCTION_EMBEDDING_PROVIDER=ollama
PRODUCTION_EMBEDDING_BASE_URL=http://ollama:11434/v1
PRODUCTION_EMBEDDING_API_KEY=
PRODUCTION_EMBEDDING_MODEL=nomic-embed-text:v1.5
PRODUCTION_EMBEDDING_DIMENSIONS=768

PRODUCTION_EMAIL_MODE=sandbox
PRODUCTION_EMAIL_LIVE_ENABLED=false
PRODUCTION_SMTP_HOST=mailpit
PRODUCTION_SMTP_PORT=1025
PRODUCTION_SMTP_FROM=atlas@localhost

PRODUCTION_BILLING_PROVIDER=sandbox
PRODUCTION_STRIPE_SECRET_KEY=
PRODUCTION_STRIPE_WEBHOOK_SECRET=
PRODUCTION_STRIPE_PRICE_IDS=
PRODUCTION_BILLING_PUBLIC_URL=
PRODUCTION_CAMPAIGN_LINK_SECRET=

PRODUCTION_HOOK_KEY_ID=
PRODUCTION_HOOK_SECRET=
PRODUCTION_INBOX_WEBHOOK_SECRET=
PRODUCTION_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
PRODUCTION_WHATSAPP_WEBHOOK_APP_SECRET=
PRODUCTION_WHATSAPP_LIVE_ENABLED=false

PRODUCTION_GOOGLE_CALENDAR_CLIENT_ID=
PRODUCTION_GOOGLE_CALENDAR_CLIENT_SECRET=
PRODUCTION_GOOGLE_CALENDAR_REDIRECT_URI=
PRODUCTION_GOOGLE_CALENDAR_WEB_ORIGIN=
