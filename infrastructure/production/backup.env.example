# Root-only file. Install to /etc/atlas/production-backup.env with mode 0600.
# The passphrase is not stored in the backup archive. Keep a copy in a password manager.
ATLAS_BACKUP_PASSPHRASE=replace-with-a-long-random-string
ATLAS_BACKUP_DIR=/var/backups/atlas
ATLAS_BACKUP_KEEP=14
ATLAS_COMPOSE_ENV=/opt/atlas/infrastructure/production/.env
ATLAS_BACKUP_PROJECT=atlas-production
# Optional off-host copy. Leave the URI empty until a bucket exists. Do not buy one for this step.
ATLAS_BACKUP_S3_URI=
ATLAS_BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
