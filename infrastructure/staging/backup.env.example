# Copy to /etc/atlas/backup.env on the VPS and chmod 600.
# This file is an example. Do not put a real passphrase or cloud key in Git.

ATLAS_BACKUP_PROJECT=atlas-staging
ATLAS_BACKUP_DIR=/var/backups/atlas
ATLAS_BACKUP_KEEP=14
ATLAS_BACKUP_PASSPHRASE=replace-with-a-long-random-string

# Optional S3-compatible bucket. Leave these empty until the bucket exists.
# The backup command refuses the upload when the passphrase above is empty.
ATLAS_BACKUP_S3_URI=
ATLAS_BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
