# Copy to infrastructure/staging/.env before starting the staging stack.
# .env is gitignored. Replace every placeholder. These are not production secrets.
# The smoke test writes this file when it is missing. Do not point it at the local dev database.

STAGING_ENVIRONMENT=production
STAGING_SECRET_KEY=replace-with-a-long-random-string
# Each encryption key must be independent of the session signing secret.
# Retain existing entries during rotation so stored provider credentials can be decrypted.
STAGING_CREDENTIAL_ENCRYPTION_KEYS=stage-01=replace-with-an-independent-random-string
STAGING_POSTGRES_USER=atlas
STAGING_POSTGRES_PASSWORD=replace-with-a-long-random-string
STAGING_POSTGRES_DB=atlas
STAGING_N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
STAGING_N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.49.6

# Local TLS test. On a VPS, set the public hostname and publish 80 and 443.
STAGING_HOST=atlas.localhost
STAGING_HTTP_PORT=8080
STAGING_HTTPS_PORT=8443
STAGING_CORS_ORIGINS=https://atlas.localhost:8443

# Create the first administrator with python -m app.scripts.bootstrap.
# Pass the JSON on stdin. Do not store that password in this file or the image.

# Chat. Leave the key empty until a Groq key is placed in this gitignored file.
STAGING_LLM_PROVIDER=openai
STAGING_LLM_BASE_URL=https://api.openai.com/v1
STAGING_LLM_API_KEY=
STAGING_LLM_MODEL=gpt-4o-mini
STAGING_EMBEDDING_PROVIDER=ollama
STAGING_EMBEDDING_BASE_URL=http://ollama:11434/v1
STAGING_EMBEDDING_API_KEY=
STAGING_EMBEDDING_MODEL=nomic-embed-text:v1.5
STAGING_EMBEDDING_DIMENSIONS=768

# Optional. Create the webhook key in ATLAS, then set these and recreate n8n.
STAGING_HOOK_KEY_ID=
STAGING_HOOK_SECRET=
STAGING_INBOX_WEBHOOK_SECRET=
STAGING_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
STAGING_WHATSAPP_WEBHOOK_APP_SECRET=
# Stripe is optional. A staging Stripe account must use test API credentials.
STAGING_BILLING_PROVIDER=sandbox
STAGING_STRIPE_SECRET_KEY=
STAGING_STRIPE_WEBHOOK_SECRET=
STAGING_STRIPE_PRICE_IDS=
STAGING_BILLING_PUBLIC_URL=https://atlas.localhost:8443
STAGING_CAMPAIGN_PUBLIC_URL=https://atlas.localhost:8443
STAGING_CAMPAIGN_LINK_SECRET=
STAGING_GOOGLE_CALENDAR_CLIENT_ID=
STAGING_GOOGLE_CALENDAR_CLIENT_SECRET=
STAGING_GOOGLE_CALENDAR_REDIRECT_URI=
STAGING_GOOGLE_CALENDAR_WEB_ORIGIN=
STAGING_SMTP_FROM=atlas@localhost
STAGING_LOG_LEVEL=INFO
