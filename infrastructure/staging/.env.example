# Copy to infrastructure/staging/.env before starting the staging stack.
# .env is gitignored. Replace every placeholder. These are not production secrets.
# The smoke test writes this file when it is missing. Do not point it at the local dev database.

STAGING_ENVIRONMENT=development
STAGING_SECRET_KEY=replace-with-a-long-random-string
STAGING_POSTGRES_USER=atlas
STAGING_POSTGRES_PASSWORD=replace-with-a-long-random-string
STAGING_POSTGRES_DB=atlas
STAGING_N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# Local TLS test. On a VPS, set the public hostname and publish 80 and 443.
STAGING_HOST=atlas.localhost
STAGING_HTTP_PORT=8080
STAGING_HTTPS_PORT=8443
STAGING_CORS_ORIGINS=https://atlas.localhost:8443

# Bootstrap users. The seed runs only while STAGING_ENVIRONMENT=development.
# Switch to production after the seed. Production refuses to seed again.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-long-random-string
SEED_ADMIN_NAME=Staging Admin
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=replace-with-a-long-random-string
SEED_STAFF_NAME=Staging Staff
SEED_OUTSIDER_EMAIL=outsider@example.org
SEED_OUTSIDER_PASSWORD=replace-with-a-long-random-string
SEED_OUTSIDER_NAME=Staging Outsider

# Chat. Leave the key empty until a Groq key is placed in this gitignored file.
STAGING_LLM_PROVIDER=openai
STAGING_LLM_BASE_URL=https://api.openai.com/v1
STAGING_LLM_API_KEY=
STAGING_LLM_MODEL=gpt-4o-mini

# Optional. Create the webhook key in ATLAS, then set these and recreate n8n.
STAGING_HOOK_KEY_ID=
STAGING_HOOK_SECRET=
STAGING_SMTP_FROM=atlas@localhost
STAGING_LOG_LEVEL=INFO
