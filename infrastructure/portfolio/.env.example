# Copy to infrastructure/portfolio/.env before the first boot.
# .env is gitignored. Replace every placeholder. Preflight rejects this file unchanged.
# Do not point these values at the development database or infrastructure/staging/.env.
# Do not put seed passwords, provider keys, or Stripe keys in this file.

PORTFOLIO_ENVIRONMENT=development
PORTFOLIO_PUBLIC_DEMO=true
PORTFOLIO_SECRET_KEY=replace-with-a-long-random-string
# Independent of the session secret. Keep previous entries while older seals exist.
PORTFOLIO_CREDENTIAL_ENCRYPTION_KEYS=demo-01=replace-with-an-independent-random-string
PORTFOLIO_POSTGRES_USER=atlas
PORTFOLIO_POSTGRES_PASSWORD=replace-with-a-long-random-string
PORTFOLIO_POSTGRES_DB=atlas_portfolio

# Local proof uses atlas.localhost and high ports.
# A public name must use ports 80 and 443 so Caddy can finish the HTTP-01 challenge.
PORTFOLIO_HOST=atlas.localhost
PORTFOLIO_HTTP_PORT=19380
PORTFOLIO_HTTPS_PORT=19343
PORTFOLIO_CORS_ORIGINS=https://atlas.localhost:19343
PORTFOLIO_CAMPAIGN_PUBLIC_URL=https://atlas.localhost:19343
PORTFOLIO_LOG_LEVEL=INFO
PORTFOLIO_COOKIE_SECURE=true

# The serving process uses the deterministic provider. Leave these empty.
PORTFOLIO_LLM_API_KEY=
PORTFOLIO_EMBEDDING_API_KEY=
PORTFOLIO_STRIPE_SECRET_KEY=
PORTFOLIO_GOOGLE_CALENDAR_CLIENT_SECRET=
