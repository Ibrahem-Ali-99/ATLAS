# One public origin. FastAPI routes are /api/v1, so the prefix is forwarded as-is.
# A *.localhost name gets Caddy's local CA. A public name gets Let's Encrypt.
# Staging sets ATLAS_SITE_HOST from STAGING_HOST. Production sets it from PRODUCTION_HOST.
{$ATLAS_SITE_HOST:atlas.localhost} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	@public not host localhost *.localhost 127.0.0.1
	header @public Strict-Transport-Security "max-age=15552000"

	@api expression `{http.request.uri.path}.startsWith("/api/") || {http.request.uri.path} == "/api"`
	handle @api {
		header Cache-Control "no-store"
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				response_header_timeout 180s
				read_timeout 180s
				write_timeout 180s
			}
		}
	}

	# Development mode exposes FastAPI's schema. The public origin does not.
	@hidden expression `{http.request.uri.path}.startsWith("/docs") || {http.request.uri.path} == "/openapi.json" || {http.request.uri.path}.startsWith("/redoc")`
	handle @hidden {
		respond "Not found" 404
	}

	handle {
		encode gzip
		reverse_proxy web:3000
	}
}
